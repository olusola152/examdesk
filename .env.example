# Copy this file to .env and fill in your values.

# ---- Flask
SECRET_KEY=put-a-long-random-string-here

# ---- Supabase database (Project Settings > Database > Connection string > "Session pooler")
# Replace [YOUR-PASSWORD] with your database password. If the password has symbols like @ # / ?, URL-encode them.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---- Supabase storage (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# The service_role key (secret!). Never put it in front-end code or share it.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=examdesk

# ---- AI Professor (optional but recommended)
ANTHROPIC_API_KEY=

# ---- OFFLINE AI (free) — used automatically when ANTHROPIC_API_KEY is empty
# Install Ollama from https://ollama.com, then run:  ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
# Force a mode if you want: claude | ollama | basic
AI_PROVIDER=

# ---- AI Professor's VOICE
# Default: natural Nigerian voice when online (en-NG-AbeoNeural), Windows voices when offline, browser as last resort.
# Other voices: en-NG-EzinneNeural (female), en-GB-RyanNeural, en-US-GuyNeural ...
TTS_VOICE=en-NG-AbeoNeural
TTS_RATE=-5%
# Force one engine: edge | sapi | browser   (sapi = Windows voices, works offline)
TTS_ENGINE=
# Pick a Windows voice by part of its name, e.g. David or Zira
TTS_SAPI_VOICE=

# ---- 3D teacher (optional) — put teacher.glb in static/teacher/ (see static/teacher/README.txt)
TEACHER_CREDIT=
# Turn the 3D teacher towards the board (degrees, 0 = facing the class), size (1 = full body, 1.2 = bigger), hand gestures on/off
TEACHER_TURN=12
TEACHER_ZOOM=1
TEACHER_GESTURE=1
